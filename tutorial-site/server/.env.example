PORT=4000

# --- Database (MongoDB Atlas) ---
# From Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <password> and add the db name before the "?".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/reanphysics?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173

# Public URL of THIS server (used to build ABA's return_url callback).
# In production this must be a URL ABA's servers can reach, not localhost --
# e.g. https://reanphysics-api.onrender.com once deployed on Render.
SERVER_URL=http://localhost:4000

# --- Cloudflare R2 (file uploads: thumbnails, covers, PDFs) ---
# Cloudflare dashboard > R2 > Manage API tokens > create a token scoped to
# your bucket, with Object Read & Write permission.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The bucket's public URL, no trailing slash -- either the R2.dev dev URL
# (R2 > your bucket > Settings > enable "Public Development URL") or a
# custom domain you've connected to the bucket.
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ABA PayWay (Cambodia) -- register a sandbox account at
# https://sandbox.payway.com.kh/register-sandbox/ to get these.
ABA_BASE_URL=https://checkout-sandbox.payway.com.kh
ABA_MERCHANT_ID=replace-with-sandbox-merchant-id
ABA_API_KEY=replace-with-sandbox-api-key

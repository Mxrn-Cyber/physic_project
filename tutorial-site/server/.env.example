PORT=4000

# --- Database (MongoDB Atlas) ---
# From Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <password> and add the db name before the "?".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/reanphysics?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173

# Public URL of THIS server (used to build ABA's return_url callback).
# In production this must be a URL ABA's servers can reach, not localhost --
# e.g. https://reanphysics-api.onrender.com once deployed on Render.
SERVER_URL=http://localhost:4000

# --- Cloudflare R2 (file uploads: thumbnails, covers, PDFs) ---
# Cloudflare dashboard > R2 > Manage API tokens > create a token scoped to
# your bucket, with Object Read & Write permission.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The bucket's public URL, no trailing slash -- either the R2.dev dev URL
# (R2 > your bucket > Settings > enable "Public Development URL") or a
# custom domain you've connected to the bucket.
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ABA PayWay (Cambodia) -- register a sandbox account at
# https://sandbox.payway.com.kh/register-sandbox/ to get these.
ABA_BASE_URL=https://checkout-sandbox.payway.com.kh
ABA_MERCHANT_ID=replace-with-sandbox-merchant-id
ABA_API_KEY=replace-with-sandbox-api-key

# --- Resend (signup + password-reset OTP emails) ---
# Sign up at https://resend.com, then Dashboard > API Keys > create one.
RESEND_API_KEY=re_replace_with_your_api_key
# Optional: defaults to Resend's no-verification-needed shared address.
# Once you verify your own domain in Resend, change this to e.g.
# "ReanPhysics <no-reply@yourdomain.com>".
RESET_EMAIL_FROM=ReanPhysics <onboarding@resend.dev>

# --- One-time codes (signup verification + password reset) ---
# How long a 6-digit code stays valid, in minutes.
OTP_TTL_MINUTES=10

# --- Google sign-in ---
# Google Cloud Console > APIs & Services > Credentials > Create Credentials >
# OAuth client ID > Web application. Add your site URL (and localhost:5173
# for dev) under "Authorized JavaScript origins". Copy the Client ID here --
# it must match VITE_GOOGLE_CLIENT_ID in client/.env exactly.
GOOGLE_CLIENT_ID=

# --- Twilio (SMS OTP codes) ---
# Sign up at https://www.twilio.com/try-twilio, then Console > Account Info
# for the SID/token, and Phone Numbers > Buy a number for the from-number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

PORT=4000
MONGO_URI=mongodb://localhost:27017/tutorial-site
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173
# Public URL of THIS server (used to build ABA's return_url callback).
# In production this must be a URL ABA's servers can reach, not localhost.
SERVER_URL=http://localhost:4000

# ABA PayWay (Cambodia) -- register a sandbox account at
# https://sandbox.payway.com.kh/register-sandbox/ to get these.
ABA_BASE_URL=https://checkout-sandbox.payway.com.kh
ABA_MERCHANT_ID=replace-with-sandbox-merchant-id
ABA_API_KEY=replace-with-sandbox-api-key

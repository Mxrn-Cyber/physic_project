# Only needed for production builds (Cloudflare). Leave unset for local dev
# -- the Vite dev server proxies /api to localhost:4000 automatically.
# Set this in your Cloudflare Pages/Workers project's build environment
# variables to your deployed Render API URL, including the /api suffix:
VITE_API_URL=https://reanphysics-api.onrender.com/api

# Google OAuth Client ID -- must be the SAME client ID as GOOGLE_CLIENT_ID
# in server/.env. Create it in Google Cloud Console > APIs & Services >
# Credentials > Create Credentials > OAuth client ID > Web application.
# Leave blank and the "Sign in with Google" button just won't render.
VITE_GOOGLE_CLIENT_ID=
